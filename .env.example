# --- LINE (LINE Developers Console > your channel > Messaging API / Basic settings) ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Your LINE userId (starts with U...). Leave empty first; the bot will reply with it.
# Several users: separate with commas.
ALLOWED_USER_IDS=

# --- Claude Code (run `claude setup-token` on the server and paste the token) ---
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_MODEL_FAST=haiku
CLAUDE_MODEL_SMART=sonnet
CLAUDE_TIMEOUT=120

# --- Cloudflare Tunnel (only when using `--profile tunnel`) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Other ---
# Host port (127.0.0.1 only). Change if 8000 is taken.
BOT_PORT=8000
KEEP_SLIPS=true
MONTHLY_SUMMARY_DAY=1
MONTHLY_SUMMARY_HOUR=9
TZ_NAME=Asia/Bangkok
